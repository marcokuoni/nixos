+# Audio: PipeWire (with PulseAudio and ALSA compatibility).
+{
+  services.pulseaudio.enable = false;
+  services.pipewire = {
+    enable = true;
+    alsa.enable = true;
+    alsa.support32Bit = true;
+    pulse.enable = true;
+    # extraConfig.pipewire."10-airplay" = {
+    #   "context.modules" = [
+    #     {
+    #       name = "libpipewire-module-raop-discover";
+    #       args = {
+    #         "stream.props" = {
+    #           "sess.latency.msec" = 2000;
+    #         };
+    #       };
+    #     }
+    #   ];
+    # };
+  };
+
+  # realtime priority for low-latency audio
+  security.rtkit.enable = true;
+}
diff --git a/modules/nixos/boot.nix b/modules/nixos/boot.nix
new file mode 100644
index 0000000..fa166d9
--- /dev/null
+++ b/modules/nixos/boot.nix
@@ -0,0 +1,26 @@
+# Boot loader and the encrypted root disk.
+{
+  boot = {
+    loader = {
+      systemd-boot = {
+        enable = true;
+        # boot menu shows the last 5 generations
+        configurationLimit = 5;
+      };
+      efi.canTouchEfiVariables = true;
+    };
+
+    initrd = {
+      # systemd in the initrd is needed for FIDO2 (YubiKey) disk unlocking
+      systemd.enable = true;
+
+      luks.devices.cryptroot = {
+        device = "/dev/disk/by-partlabel/CRYPTROOT";
+        # unlock with a YubiKey; without one, a passphrase is asked after the
+        # token timeout (if a passphrase key slot exists)
+        # https://nixos.org/manual/nixos/stable/#sec-luks-file-systems-fido2-systemd
+        crypttabExtraOpts = [ "fido2-device=auto" ];
+      };
+    };
+  };
+}
