new file mode 100644
index 0000000..46ce878
--- /dev/null
+++ b/modules/nixos/devices.nix
@@ -0,0 +1,17 @@
+# Extra devices: Bluetooth, keyboard config in the browser, presenter.
+{ pkgs, ... }:
+{
+  hardware.bluetooth.enable = true;
+
+  # virtual input devices (needed by Projecteur)
+  hardware.uinput.enable = true;
+
+  services.udev = {
+    # configure the Bastard Keyboard in the browser (WebHID)
+    extraRules = ''
+      KERNEL=="hidraw*", SUBSYSTEM=="hidraw", MODE="0660", GROUP="users", TAG+="uaccess", TAG+="udev-acl"
+    '';
+    # Projecteur (presenter / laser pointer)
+    packages = [ pkgs.projecteur ];
+  };
+}
diff --git a/modules/nixos/locale.nix b/modules/nixos/locale.nix
new file mode 100644
index 0000000..5ffcc24
--- /dev/null
+++ b/modules/nixos/locale.nix
@@ -0,0 +1,25 @@
+# Time zone, language and keyboard.
+{
+  time.timeZone = "Europe/Zurich";
+
+  # English UI, Swiss German formats (dates, currency, paper size, …)
+  i18n = {
+    defaultLocale = "en_US.UTF-8";
+    extraLocaleSettings = {
+      LC_ADDRESS = "de_CH.UTF-8";
+      LC_COLLATE = "de_CH.UTF-8";
+      LC_CTYPE = "de_CH.UTF-8";
+      LC_IDENTIFICATION = "de_CH.UTF-8";
+      LC_MEASUREMENT = "de_CH.UTF-8";
+      LC_MONETARY = "de_CH.UTF-8";
+      LC_NAME = "de_CH.UTF-8";
+      LC_NUMERIC = "de_CH.UTF-8";
+      LC_PAPER = "de_CH.UTF-8";
+      LC_TELEPHONE = "de_CH.UTF-8";
+      LC_TIME = "de_CH.UTF-8";
+    };
+  };
+
+  # Swiss German keyboard on the text console
+  console.keyMap = "de_CH-latin1";
+}
diff --git a/modules/nixos/networking.nix b/modules/nixos/networking.nix
new file mode 100644
index 0000000..4d93591
--- /dev/null
+++ b/modules/nixos/networking.nix
@@ -0,0 +1,40 @@
+# Network: NetworkManager, firewall, local host names.
+# VPN profiles are in vpn.nix.
+{ pkgs, lib, ... }:
+{
+  networking = {
+    networkmanager = {
+      enable = true;
+      # VPN plugins for OpenVPN and OpenConnect (Cisco/Fortinet)
+      plugins = with pkgs; [
+        networkmanager-openvpn
+        (networkmanager-openconnect.override { withGnome = true; })
+      ];
+    };
+
+    # local dev domains and the lab server
+    extraHosts = ''
+      127.0.0.1 bank-avera.local
+      127.0.0.1 ksgl.local
+      127.0.0.1 lemonbrain.local
+      127.0.0.1 backoffice.local
+      127.0.0.1 formidable.local
+      127.0.0.1 kulturkarussell.local
+      127.0.0.1 innovationsbox.internal
+      152.96.10.67 ins-lab
+    '';
+
+    # Xdebug (PHP) connects from containers to the host. Open it only on the
+    # Docker bridges (docker0, and br-* for docker-compose networks), not on
+    # Wi-Fi. PHP on the host itself uses localhost, which is always allowed.
+    firewall.interfaces = {
+      docker0.allowedTCPPorts = [ 9003 ];
+      "br-+".allowedTCPPorts = [ 9003 ];
+    };
+
+    useDHCP = lib.mkDefault true;
+
+    # needed for VPN DNS to work correctly with NetworkManager
+    resolvconf.enable = true;
+  };
+}
diff --git a/modules/nixos/nix.nix b/modules/nixos/nix.nix
new file mode 100644
index 0000000..33fec52
--- /dev/null
+++ b/modules/nixos/nix.nix
@@ -0,0 +1,33 @@
+# Nix itself: flakes, binary caches, garbage collection.
+{
+  nix = {
+    settings = {
+      experimental-features = [
+        "nix-command"
+        "flakes"
+      ];
+      # deduplicate identical files in the store
+      auto-optimise-store = true;
+      # start garbage collection when less than 50 GB are free
+      min-free = "50G";
+      # extra binary caches, so these don't have to be built locally
+      substituters = [
+        "https://niri.cachix.org"
+        "https://noctalia.cachix.org"
+      ];
+      trusted-public-keys = [
+        "niri.cachix.org-1:Wv0OmO7PsuocRKzfDoJ3mulSl7Z6oezYhGhR+3W2964="
+        "noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4="
+      ];
+    };
+
+    # weekly cleanup of everything older than 7 days
+    gc = {
+      automatic = true;
+      dates = "weekly";
+      options = "--delete-older-than 7d";
+    };
+  };
+
+  nixpkgs.config.allowUnfree = true;
+}
diff --git a/modules/nixos/power.nix b/modules/nixos/power.nix
new file mode 100644
index 0000000..7686fa0
--- /dev/null
+++ b/modules/nixos/power.nix
@@ -0,0 +1,14 @@
+# Battery, power profiles and firmware updates.
+{
+  services = {
+    power-profiles-daemon.enable = true;
+    upower.enable = true;
+
+    # firmware updates (BIOS, Thunderbolt, SSD, …) from LVFS:
+    # fwupdmgr refresh && fwupdmgr update
+    fwupd.enable = true;
+
+    # D-Bus is needed by almost everything (keyring, NetworkManager, PipeWire, …)
+    dbus.enable = true;
+  };
+}
