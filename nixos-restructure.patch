From 204f8f0b4fc3343d9199c3139a384d0721de080a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 17:41:10 +0200
Subject: [PATCH 04/11] scripts: fix lazyvim-diff-plugins, use
 writeShellApplication

lazyvim-diff-plugins looked for a "path = " line in init.lua that does
not exist, so it never found the Nix plugin folder; it now asks nvim
for require("nix").plugins. Both scripts are built with
writeShellApplication (strict mode, shellcheck at build time, tools on
PATH via runtimeInputs).

Verified: only these two scripts change in the system.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011ZuxjHwJWLzvZgbYArzrwc
---
 home/niri/beamer-mirror.nix | 25 +++++++++++++--------
 home/nvim/diff-plugins.nix  | 45 ++++++++++++++++++++-----------------
 2 files changed, 41 insertions(+), 29 deletions(-)

diff --git a/home/niri/beamer-mirror.nix b/home/niri/beamer-mirror.nix
index 9c21ac0..8364d08 100644
--- a/home/niri/beamer-mirror.nix
+++ b/home/niri/beamer-mirror.nix
@@ -1,12 +1,19 @@
-{pkgs, ...}: {
-  # beamer-mirror: turns on HDMI output and starts mirroring eDP-1 to it
-  # usage: run manually or bind to a key in niri
+# beamer-mirror: switch on the HDMI output and mirror the laptop screen to it.
+# (Mod+P in niri mirrors the focused output instead.)
+{ pkgs, ... }:
+{
   home.packages = [
-    (pkgs.writeShellScriptBin "beamer-mirror" ''
-      #!/usr/bin/env bash
-      wlr-randr --output HDMI-A-1 --on
-      wl-mirror eDP-1 &
-      sleep 0.5
-    '')
+    (pkgs.writeShellApplication {
+      name = "beamer-mirror";
+      runtimeInputs = with pkgs; [
+        wlr-randr
+        wl-mirror
+      ];
+      text = ''
+        wlr-randr --output HDMI-A-1 --on
+        wl-mirror eDP-1 &
+        sleep 0.5
+      '';
+    })
   ];
 }
diff --git a/home/nvim/diff-plugins.nix b/home/nvim/diff-plugins.nix
index 957532a..fcb13d6 100644
--- a/home/nvim/diff-plugins.nix
+++ b/home/nvim/diff-plugins.nix
@@ -1,23 +1,28 @@
-{ pkgs, ... }: {
-  # lazyvim-diff-plugins: compare plugins known to Nix vs plugins loaded by lazy
-  # useful for finding plugins lazy downloaded that should be added to the Nix config
+# lazyvim-diff-plugins: compare the plugins Nix provides with the plugins
+# lazy.nvim loads. A plugin only in "lazy" is missing from `plugins` in
+# default.nix (lazy can't download it, so it won't work).
+{ pkgs, ... }:
+{
   home.packages = [
-    (pkgs.writeShellScriptBin "lazyvim-diff-plugins" ''
-      #!/usr/bin/env bash
-      # plugins as seen by lazy at runtime
-      lazy_plugins() {
-        nvim --headless \
-          -c ':lua for _, plugin in ipairs(require("lazy").plugins()) do print(plugin.name) end' \
-          -c 'q' 2>&1 \
-          | grep -vxF 'lazy.nvim' \
-          | sort
-      }
-      # plugins available in the nix linkFarm
-      nix_plugins() {
-        dir=$(awk -F'"' '/path = / {print $2}' ~/.config/nvim/init.lua)
-        ls -1 "$dir" | sort
-      }
-      diff -w -u --label nix <(nix_plugins) --label lazy <(lazy_plugins)
-    '')
+    (pkgs.writeShellApplication {
+      name = "lazyvim-diff-plugins";
+      # uses your configured nvim from PATH (not a plain one from nixpkgs)
+      text = ''
+        # plugins lazy.nvim knows at runtime
+        lazy_plugins() {
+          nvim --headless \
+            -c 'lua for _, p in ipairs(require("lazy").plugins()) do print(p.name) end' \
+            -c 'qa!' 2>&1 \
+            | grep -vxF 'lazy.nvim' \
+            | sort
+        }
+        # plugins in the Nix plugin folder (require("nix").plugins, see default.nix)
+        nix_plugins() {
+          dir=$(nvim --headless -c 'lua io.stdout:write(require("nix").plugins)' -c 'qa!' 2>/dev/null)
+          find "$dir" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort
+        }
+        diff -w -u --label nix <(nix_plugins) --label lazy <(lazy_plugins)
+      '';
+    })
   ];
 }
-- 
