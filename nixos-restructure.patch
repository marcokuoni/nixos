diff --git a/hosts/laptop/default.nix b/hosts/laptop/default.nix
new file mode 100644
index 0000000..e0d0ee9
--- /dev/null
+++ b/hosts/laptop/default.nix
@@ -0,0 +1,74 @@
+# The laptop "progressio": its hardware, its user, and the services it runs.
+# How things are set up is in modules/nixos (system) and home/ (user).
+{ inputs, pkgs, ... }:
+{
+  imports = [
+    ./hardware.nix
+    ../../modules/nixos
+    inputs.home-manager.nixosModules.home-manager
+    inputs.go2hs.nixosModules.default
+  ];
+
+  networking.hostName = "progressio";
+
+  users.users.progressio = {
+    isNormalUser = true;
+    shell = pkgs.nushell;
+    extraGroups = [
+      "docker"
+      "wheel" # sudo access
+      "video"
+      "audio"
+      "networkmanager"
+      "input"
+      "lp" # printing
+      "lpadmin" # manage printers
+      "dialout" # serial ports
+    ];
+  };
+  environment.shells = [ pkgs.nushell ];
+
+  # the user environment (niri, shell, editor, apps) via home-manager
+  home-manager = {
+    # use the system's nixpkgs instead of a separate instance
+    useGlobalPkgs = true;
+    # install user packages into /etc/profiles instead of ~/.nix-profile
+    useUserPackages = true;
+    # files home-manager would overwrite (e.g. a hand-made
+    # ~/.config/jj/config.toml) are renamed to *.hm-backup instead of
+    # failing the rebuild
+    backupFileExtension = "hm-backup";
+    sharedModules = [
+      inputs.niri.homeModules.niri
+      inputs.noctalia.homeModules.default
+      inputs.zen-browser.homeModules.beta
+    ];
+    users.progressio.imports = [ ../../home/progressio.nix ];
+  };
+
+  nixpkgs.overlays = [ (import ../../pkgs/overlay.nix inputs) ];
+
+  # reMarkable tablet: cloud sync + notebooks converted to PDF
+  services.remarkable-sync = {
+    enable = true;
+    user = "progressio";
+    interval = "5min";
+    extraArgs = [ "--verbose" ];
+  };
+  services.rmdoc-to-pdf = {
+    enable = true;
+    user = "progressio";
+    # inputDir  = "/home/progressio/remarkable";    # default
+    # outputDir = "/home/progressio/remarkable-pdf"; # default
+    # interval  = "10min";                           # default
+  };
+
+  # Unitree Go2 robot dev network
+  go2 = {
+    enable = true;
+    interface = "enp1s0f0";
+    address = "192.168.123.99"; # default
+  };
+
+  system.stateVersion = "25.05";
+}
diff --git a/hosts/laptop/hardware.nix b/hosts/laptop/hardware.nix
new file mode 100644
index 0000000..e6ce9d0
--- /dev/null
+++ b/hosts/laptop/hardware.nix
@@ -0,0 +1,50 @@
+# Hardware of this laptop as detected by nixos-generate-config:
+# kernel modules, file systems, swap, CPU. Safe to regenerate; boot loader,
+# disk unlocking and everything else live in modules/nixos.
+{
+  config,
+  lib,
+  modulesPath,
+  ...
+}:
+{
+  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];
+
+  boot = {
+    initrd = {
+      availableKernelModules = [
+        "nvme"
+        "xhci_pci"
+        "thunderbolt"
+        "uas"
+        "sd_mod"
+      ];
+      kernelModules = [
+        "dm-snapshot"
+        "cryptd"
+      ];
+    };
+    kernelModules = [ "kvm-amd" ];
+    extraModulePackages = [ ];
+  };
+
+  fileSystems."/" = {
+    device = "/dev/disk/by-label/NIXOS_ROOT";
+    fsType = "ext4";
+  };
+
+  fileSystems."/boot" = {
+    device = "/dev/disk/by-label/NIXOS_BOOT";
+    fsType = "vfat";
+    options = [
+      "fmask=0077"
+      "dmask=0077"
+    ];
+  };
+
+  swapDevices = [ { device = "/dev/disk/by-label/NIXOS_SWAP"; } ];
+
+  networking.useDHCP = lib.mkDefault true;
+  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
+  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
+}
